{
  "name": "dsh-observer",
  "version": "0.1.0",
  "description": "Evidence-based execution diagnostics for DeepSeek Harness sessions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && tsdown",
    "build:types": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "rimraf lib",
    "lint": "oxlint src tests tsdown.config.ts vitest.config.ts",
    "pack:check": "pnpm pack --pack-destination .pack",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.host.json && tsc --noEmit -p tsconfig.test.client.json",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-llm-retry": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5 <1",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.5 <1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-retry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "29.1.1",
    "js-yaml": "^4.2.0",
    "lightningcss": "^1.32.0",
    "oxlint": "1.76.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "synckit": "^0.11.11",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
